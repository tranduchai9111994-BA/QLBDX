generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement()) @map("Id")
  username     String    @unique @map("Username") @db.NVarChar(50)
  passwordHash String    @map("PasswordHash") @db.NVarChar(255)
  fullName     String    @map("FullName") @db.NVarChar(100)
  email        String?   @map("Email") @db.NVarChar(100)
  phone        String?   @map("Phone") @db.NVarChar(20)
  role         String    @default("staff") @map("Role") @db.NVarChar(20)
  isActive     Boolean   @default(true) @map("IsActive")
  createdAt    DateTime  @default(now()) @map("CreatedAt")
  updatedAt    DateTime  @default(now()) @updatedAt @map("UpdatedAt")

  parkingRecords         ParkingRecord[]          @relation("CreatedByUser")
  payments               Payment[]                @relation("PaymentCreatedBy")
  activityLogs           UserActivityLog[]
  vehicleTypeRateChanges VehicleTypeRateHistory[]
  packagePriceChanges    PackagePriceHistory[]

  @@map("Users")
}

model Customer {
  id           Int       @id @default(autoincrement()) @map("Id")
  fullName     String    @map("FullName") @db.NVarChar(100)
  phone        String    @map("Phone") @db.NVarChar(20)
  email        String?   @map("Email") @db.NVarChar(100)
  address      String?   @map("Address") @db.NVarChar(255)
  identityCard String?   @map("IdentityCard") @db.NVarChar(20)
  isActive     Boolean   @default(true) @map("IsActive")
  createdAt    DateTime  @default(now()) @map("CreatedAt")
  updatedAt    DateTime  @default(now()) @updatedAt @map("UpdatedAt")

  vehicles         Vehicle[]
  customerPackages CustomerPackage[]

  @@map("Customers")
}

model VehicleType {
  id          Int       @id @default(autoincrement()) @map("Id")
  name        String    @map("Name") @db.NVarChar(50)
  description String?   @map("Description") @db.NVarChar(200)
  hourlyRate  Decimal   @map("HourlyRate") @db.Decimal(10, 2)
  dailyRate   Decimal   @map("DailyRate") @db.Decimal(10, 2)
  monthlyRate Decimal   @map("MonthlyRate") @db.Decimal(10, 2)
  createdAt   DateTime  @default(now()) @map("CreatedAt")

  vehicles        Vehicle[]
  parkingPackages ParkingPackage[]
  parkingRecords  ParkingRecord[]
  rateHistory     VehicleTypeRateHistory[]

  @@map("VehicleTypes")
}

/// Lịch sử giá theo giờ/ngày/tháng của 1 loại xe. Mỗi lần đổi giá (ngay hoặc đặt lịch
/// cho tương lai) tạo 1 dòng mới — KHÔNG sửa đè các dòng cũ. "Giá hiện hành" = dòng có
/// effectiveFrom lớn nhất mà effectiveFrom <= thời điểm hiện tại.
model VehicleTypeRateHistory {
  id            Int      @id @default(autoincrement()) @map("Id")
  vehicleTypeId Int      @map("VehicleTypeId")
  hourlyRate    Decimal  @map("HourlyRate") @db.Decimal(10, 2)
  dailyRate     Decimal  @map("DailyRate") @db.Decimal(10, 2)
  monthlyRate   Decimal  @map("MonthlyRate") @db.Decimal(10, 2)
  effectiveFrom DateTime @map("EffectiveFrom")
  changedBy     Int?     @map("ChangedBy")
  createdAt     DateTime @default(now()) @map("CreatedAt")

  vehicleType VehicleType @relation(fields: [vehicleTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  changer     User?       @relation(fields: [changedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([vehicleTypeId, effectiveFrom])
  @@map("VehicleTypeRateHistory")
}

model Vehicle {
  id            Int       @id @default(autoincrement()) @map("Id")
  customerId    Int       @map("CustomerId")
  vehicleTypeId Int       @map("VehicleTypeId")
  licensePlate  String    @unique @map("LicensePlate") @db.NVarChar(20)
  brand         String?   @map("Brand") @db.NVarChar(50)
  model         String?   @map("Model") @db.NVarChar(50)
  color         String?   @map("Color") @db.NVarChar(30)
  createdAt     DateTime  @default(now()) @map("CreatedAt")
  updatedAt     DateTime  @default(now()) @updatedAt @map("UpdatedAt")

  customer        Customer          @relation(fields: [customerId], references: [id])
  vehicleType     VehicleType       @relation(fields: [vehicleTypeId], references: [id])
  parkingRecords  ParkingRecord[]
  customerPackages CustomerPackage[]

  @@index([customerId])
  @@index([vehicleTypeId])
  @@map("Vehicles")
}

model ParkingZone {
  id          Int       @id @default(autoincrement()) @map("Id")
  name        String    @map("Name") @db.NVarChar(50)
  description String?   @map("Description") @db.NVarChar(200)
  totalSpots  Int       @default(0) @map("TotalSpots")
  createdAt   DateTime  @default(now()) @map("CreatedAt")

  parkingSpots ParkingSpot[]

  @@map("ParkingZones")
}

model ParkingSpot {
  id         Int       @id @default(autoincrement()) @map("Id")
  zoneId     Int       @map("ZoneId")
  spotNumber String    @map("SpotNumber") @db.NVarChar(10)
  spotType   String    @default("standard") @map("SpotType") @db.NVarChar(20)
  status     String    @default("available") @map("Status") @db.NVarChar(20)
  createdAt  DateTime  @default(now()) @map("CreatedAt")

  zone           ParkingZone     @relation(fields: [zoneId], references: [id])
  parkingRecords ParkingRecord[]

  @@unique([zoneId, spotNumber])
  @@index([status])
  @@map("ParkingSpots")
}

model ParkingPackage {
  id            Int       @id @default(autoincrement()) @map("Id")
  name          String    @map("Name") @db.NVarChar(100)
  vehicleTypeId Int       @map("VehicleTypeId")
  durationDays  Int       @map("DurationDays")
  price         Decimal   @map("Price") @db.Decimal(10, 2)
  description   String?   @map("Description") @db.NVarChar(500)
  isActive      Boolean   @default(true) @map("IsActive")
  createdAt     DateTime  @default(now()) @map("CreatedAt")

  vehicleType      VehicleType       @relation(fields: [vehicleTypeId], references: [id])
  customerPackages CustomerPackage[]
  priceHistory     PackagePriceHistory[]

  @@map("ParkingPackages")
}

/// Lịch sử giá của 1 gói dịch vụ. Cùng nguyên tắc với VehicleTypeRateHistory: mỗi lần
/// đổi giá tạo dòng mới, không sửa đè. Khách đã đăng ký gói giữ nguyên giá đã trả
/// (xem Payment.amount) — đổi giá KHÔNG ảnh hưởng ngược các đăng ký đã có.
model PackagePriceHistory {
  id            Int      @id @default(autoincrement()) @map("Id")
  packageId     Int      @map("PackageId")
  price         Decimal  @map("Price") @db.Decimal(10, 2)
  effectiveFrom DateTime @map("EffectiveFrom")
  changedBy     Int?     @map("ChangedBy")
  createdAt     DateTime @default(now()) @map("CreatedAt")

  parkingPackage ParkingPackage @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  changer        User?          @relation(fields: [changedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([packageId, effectiveFrom])
  @@map("PackagePriceHistory")
}

model CustomerPackage {
  id         Int       @id @default(autoincrement()) @map("Id")
  customerId Int       @map("CustomerId")
  packageId  Int       @map("PackageId")
  vehicleId  Int       @map("VehicleId")
  startDate  DateTime  @map("StartDate") @db.Date
  endDate    DateTime  @map("EndDate") @db.Date
  status     String    @default("active") @map("Status") @db.NVarChar(20)
  createdAt  DateTime  @default(now()) @map("CreatedAt")

  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parkingPackage ParkingPackage @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments       Payment[]      @relation("PackagePayment")

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
  @@index([endDate])
  @@index([startDate])
  @@map("CustomerPackages")
}

model ParkingRecord {
  id            Int       @id @default(autoincrement()) @map("Id")
  vehicleId     Int?      @map("VehicleId")
  licensePlate  String    @map("LicensePlate") @db.NVarChar(20)
  vehicleTypeId Int       @map("VehicleTypeId")
  parkingSpotId Int?      @map("ParkingSpotId")
  entryTime     DateTime  @default(now()) @map("EntryTime")
  exitTime      DateTime? @map("ExitTime")
  duration      Int?      @map("Duration")
  fee           Decimal?  @map("Fee") @db.Decimal(10, 2)
  /// Giá/giờ, giá/ngày CHỐT tại thời điểm xe vào bãi — dùng để tính phí lúc xe ra,
  /// không bị ảnh hưởng nếu admin đổi giá VehicleType trong lúc xe đang đỗ.
  /// Null với bản ghi cũ trước khi có tính năng này (fallback về giá VehicleType hiện tại).
  hourlyRateApplied Decimal? @map("HourlyRateApplied") @db.Decimal(10, 2)
  dailyRateApplied  Decimal? @map("DailyRateApplied") @db.Decimal(10, 2)
  status        String    @default("parked") @map("Status") @db.NVarChar(20)
  notes         String?   @map("Notes") @db.NVarChar(500)
  createdBy     Int?      @map("CreatedBy")
  createdAt     DateTime  @default(now()) @map("CreatedAt")

  vehicle     Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleType VehicleType  @relation(fields: [vehicleTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parkingSpot ParkingSpot? @relation(fields: [parkingSpotId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator     User?        @relation("CreatedByUser", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments    Payment[]    @relation("ParkingPayment")

  // Bảng lớn nhất hệ thống (tăng nhanh theo thời gian) — mọi query Dashboard/Báo cáo/
  // Phân tích đều loc theo status/entryTime/exitTime, nên các index nay la bat buoc.
  @@index([status, entryTime])
  @@index([entryTime])
  @@index([exitTime])
  @@index([vehicleTypeId])
  @@index([parkingSpotId])
  @@index([vehicleId])
  @@map("ParkingRecords")
}

model Payment {
  id                Int       @id @default(autoincrement()) @map("Id")
  parkingRecordId   Int?      @map("ParkingRecordId")
  customerPackageId Int?      @map("CustomerPackageId")
  amount            Decimal   @map("Amount") @db.Decimal(10, 2)
  paymentMethod     String    @default("cash") @map("PaymentMethod") @db.NVarChar(30)
  paymentType       String    @default("parking") @map("PaymentType") @db.NVarChar(30)
  status            String    @default("completed") @map("Status") @db.NVarChar(20)
  paidAt            DateTime  @default(now()) @map("PaidAt")
  createdBy         Int?      @map("CreatedBy")
  notes             String?   @map("Notes") @db.NVarChar(500)

  parkingRecord   ParkingRecord?   @relation("ParkingPayment", fields: [parkingRecordId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customerPackage CustomerPackage? @relation("PackagePayment", fields: [customerPackageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator         User?            @relation("PaymentCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, paidAt])
  @@index([paidAt])
  @@index([parkingRecordId])
  @@index([customerPackageId])
  @@map("Payments")
}

model UserActivityLog {
  id         Int      @id @default(autoincrement()) @map("Id")
  userId     Int?     @map("UserId")
  username   String   @map("Username") @db.NVarChar(50)
  action     String   @map("Action") @db.NVarChar(30)
  entity     String?  @map("Entity") @db.NVarChar(50)
  entityId   Int?     @map("EntityId")
  details    String?  @map("Details") @db.NVarChar(1000)
  ipAddress  String?  @map("IpAddress") @db.NVarChar(50)
  statusCode Int?     @map("StatusCode")
  createdAt  DateTime @default(now()) @map("CreatedAt")

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdAt])
  @@index([userId])
  @@map("UserActivityLogs")
}

/// Ngưỡng định nghĩa mức độ cảnh báo (nguy hiểm/cảnh báo/thông tin) — mỗi bãi xe có thể tự chỉnh
/// vì "thế nào là nguy hiểm" khác nhau tuỳ khách hàng. Bảng dạng singleton, luôn dùng id = 1.
model AlertSettings {
  id                             Int      @id @default(1) @map("Id")
  zoneNearFullAvailable          Int      @default(2) @map("ZoneNearFullAvailable")
  zoneNearFullPercent            Float    @default(10) @map("ZoneNearFullPercent")
  zoneImbalanceMaxPercent        Float    @default(90) @map("ZoneImbalanceMaxPercent")
  zoneImbalanceMinPercent        Float    @default(30) @map("ZoneImbalanceMinPercent")
  longParkingHours               Int      @default(24) @map("LongParkingHours")
  parkingAnomalyMultiplier       Float    @default(3) @map("ParkingAnomalyMultiplier")
  parkingAnomalyMinMinutes       Int      @default(60) @map("ParkingAnomalyMinMinutes")
  suspiciousPaymentHighAmount    Decimal  @default(5000000) @map("SuspiciousPaymentHighAmount") @db.Decimal(12, 2)
  suspiciousPaymentParkingAmount Decimal  @default(300000) @map("SuspiciousPaymentParkingAmount") @db.Decimal(12, 2)
  revenueDropPercent             Float    @default(30) @map("RevenueDropPercent")
  renewalFrequencyThreshold      Int      @default(5) @map("RenewalFrequencyThreshold")
  updatedAt                      DateTime @default(now()) @updatedAt @map("UpdatedAt")
  updatedBy                      Int?     @map("UpdatedBy")

  @@map("AlertSettings")
}
