{
  "name": "parking-management-frontend",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^5.4.0",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "ajv": "^8.18.0",
    "antd": "^5.20.0",
    "axios": "^1.7.4",
    "dayjs": "^1.11.12",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.12.7",
    "typescript": "^5.5.3",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": ["src/**/*.tsx"],
        "excludedFiles": ["src/theme/**", "**/*.test.tsx"],
        "rules": {
          "no-restricted-syntax": [
            "warn",
            {
              "selector": "Literal[value=/^#([0-9a-fA-F]{3}){1,2}$/]",
              "message": "T-12: khong hardcode ma mau hex trong .tsx - dung CSS variable (var(--ten-token)) khai bao trong design-system.css, hoac them token moi neu can."
            }
          ]
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
