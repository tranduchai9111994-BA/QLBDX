# Khong tu mo trinh duyet khi `npm start` — launcher (scripts/start-silent.ps1)
# se mo mot lan duy nhat khi frontend thuc su san sang.
BROWSER=none

# Tat ESLint plugin cua webpack-dev-server: rut ~5s moi lan bien dich lai tu dau
# (36.3s -> 31.3s do thuc te). Canh bao lint truoc day chi ghi vao logs/frontend.log
# khong ai doc. Van kiem tra lint bang lenh ro rang khi can:  npm run lint
DISABLE_ESLINT_PLUGIN=true
